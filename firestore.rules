rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isProfessor(profId) {
      return isSignedIn() && userDoc().role == 'professor' && request.auth.uid == profId;
    }

    function isAluno(profId, alunoId) {
      return isSignedIn() && userDoc().role == 'aluno'
        && userDoc().professorId == profId && request.auth.uid == alunoId;
    }

    match /usuarios/{uid} {
      allow read, update: if isSignedIn() && request.auth.uid == uid;
      // Um professor também pode criar o usuarios/{uid} de um aluno que
      // acabou de cadastrar (a conta de Auth é criada num app Firebase
      // secundário, mas o Firestore precisa que o professor, já
      // autenticado, grave o vínculo dessa nova conta).
      allow create: if isSignedIn() && (request.auth.uid == uid || isProfessor(request.resource.data.professorId));
      allow delete: if false;
    }

    match /professores/{profId} {
      allow create: if isSignedIn() && request.auth.uid == profId;
      allow read, update: if isProfessor(profId);
      allow delete: if false;

      match /alunos/{alunoId} {
        allow read: if isProfessor(profId) || isAluno(profId, alunoId);
        allow write: if isProfessor(profId);

        match /treinos/{treinoId} {
          allow read: if isProfessor(profId) || isAluno(profId, alunoId);
          allow write: if isProfessor(profId);
        }

        match /avaliacoes/{avalId} {
          allow read: if isProfessor(profId) || isAluno(profId, alunoId);
          allow write: if isProfessor(profId);
        }

        match /execucoes/{execId} {
          allow read: if isProfessor(profId) || isAluno(profId, alunoId);
          allow create: if isAluno(profId, alunoId);
          allow update, delete: if false;
        }

        match /evolucao/{evoId} {
          allow read: if isProfessor(profId) || isAluno(profId, alunoId);
          allow create: if isProfessor(profId) || isAluno(profId, alunoId);
          allow update, delete: if false;
        }
      }

      match /pagamentos/{pagamentoId} {
        allow read, write: if isProfessor(profId);
      }

      match /planos/{planoId} {
        allow read, write: if isProfessor(profId);
      }

      match /exercicios/{exercicioId} {
        allow read, write: if isProfessor(profId);
      }

      match /aparelhos/{aparelhoId} {
        allow read, write: if isProfessor(profId);
      }

      match /checkins/{checkinId} {
        allow read: if isProfessor(profId);
        allow create: if isProfessor(profId) || isSignedIn() && userDoc().role == 'aluno' && userDoc().professorId == profId;
      }
    }
  }
}
