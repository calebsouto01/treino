rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function userAcademiaId() {
      return userDoc().academiaId;
    }

    function userRole() {
      return userDoc().role;
    }

    function isAdmin(academiaId) {
      return isSignedIn() && userAcademiaId() == academiaId && userRole() == 'admin';
    }

    function isProfessor(academiaId) {
      return isSignedIn() && userAcademiaId() == academiaId && userRole() == 'professor';
    }

    function isAluno(academiaId, alunoId) {
      return isSignedIn() && userAcademiaId() == academiaId && userRole() == 'aluno' && request.auth.uid == alunoId;
    }

    function isStaff(academiaId) {
      return isAdmin(academiaId) || isProfessor(academiaId);
    }

    match /usuarios/{uid} {
      allow read, update: if isSignedIn() && request.auth.uid == uid;
      // Um admin também pode criar o usuarios/{uid} de um professor/aluno que
      // acabou de registrar (a conta de Auth é criada num app Firebase
      // secundário, mas o Firestore precisa que o admin, já autenticado,
      // grave o vínculo dessa nova conta com a academia).
      allow create: if isSignedIn() && (request.auth.uid == uid || isAdmin(request.resource.data.academiaId));
      allow delete: if false;
    }

    match /academias/{academiaId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && userAcademiaId() == academiaId;
      allow update: if isAdmin(academiaId);
      allow delete: if false;

      match /professores/{profId} {
        allow read: if isStaff(academiaId) || isAluno(academiaId, request.auth.uid);
        allow write: if isAdmin(academiaId);
      }

      match /pagamentos/{pagamentoId} {
        allow read, write: if isAdmin(academiaId);
      }

      match /checkins/{checkinId} {
        allow read: if isStaff(academiaId);
        allow create: if isStaff(academiaId) || isSignedIn() && userAcademiaId() == academiaId;
      }

      match /alunos/{alunoId} {
        allow read: if isStaff(academiaId) || isAluno(academiaId, alunoId);
        allow write: if isAdmin(academiaId);

        match /treinos/{treinoId} {
          allow read: if isStaff(academiaId) || isAluno(academiaId, alunoId);
          allow write: if isStaff(academiaId);
        }

        match /execucoes/{execId} {
          allow read: if isStaff(academiaId) || isAluno(academiaId, alunoId);
          allow create: if isAluno(academiaId, alunoId);
          allow update, delete: if false;
        }

        match /avaliacoes/{avalId} {
          allow read: if isStaff(academiaId) || isAluno(academiaId, alunoId);
          allow write: if isStaff(academiaId);
        }

        match /evolucao/{evoId} {
          allow read: if isStaff(academiaId) || isAluno(academiaId, alunoId);
          allow create: if isStaff(academiaId) || isAluno(academiaId, alunoId);
          allow update, delete: if false;
        }
      }
    }
  }
}
